# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL runtime connection
# Gunakan transaction pooler untuk Next.js/Vercel.
DATABASE_URL=

# PostgreSQL migration connection
# Gunakan session pooler atau direct connection untuk Drizzle Kit.
DATABASE_MIGRATION_URL=

# Supabase client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-only Storage access
# Jangan pernah menggunakan awalan NEXT_PUBLIC_ untuk secret key ini.
SUPABASE_SECRET_KEY=

# MineBot AI
# Diaktifkan saat tahap integrasi AI.
MINEBOT_API_KEY=
